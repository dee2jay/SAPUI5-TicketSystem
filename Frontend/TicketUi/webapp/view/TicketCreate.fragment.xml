<Dialog id="idDialog" title="{i18n>titleTicketCreation}" xmlns="sap.m" xmlns:l="sap.ui.layout.form" xmlns:core="sap.ui.core">
	<content>
		<l:SimpleForm id="idSimpleForm" editable="true" class="sapUiResponsiveMargin" width="auto">
			<Label id="idCategoryLabel" text="{i18n>labelCategory}"/>
			<Select id="idCategoriesSelect" selectedKey="{ticketViewModel>/category}"
				items="{path: 'ticketCategoryViewModel>/categories',
						sorter: {path: 'value'}}" >
				<core:Item id="idValueCategoryItem" key="{ticketCategoryViewModel>key}" text="{ticketCategoryViewModel>value}" />
				
			</Select>			
			<Label id="idLocationLabel" text="{i18n>labelLocation}"/>
			<Input id="idLocationInput" value="{ticketViewModel>/location}" placeholder="{i18n>labelLocation}" liveChange=".onLocationInputLiveChange" required="true"/>
			<Label id="idCostCenterLabel" text="{i18n>labelCostCenter}"/>
			<Input id="idCostCenterInput" value="{ticketViewModel>/costCenter}" placeholder="{i18n>labelCostCenter}"/>
			<Label id="idOrderNrLabel" text="{i18n>labelOrderNr}"/>
			<Input id="idOrderNumberInput" value="{ticketViewModel>/orderNumber}" placeholder="{i18n>labelOrderNr}"/>
			<Label id="idTitleLabel" text="{i18n>labelTitle}"/>
			<Input id="idTitleInput" value="{ticketViewModel>/title}" placeholder="{i18n>labelTitle}"/>
			<TextArea id="idDescriptionTextArea" value="{ticketViewModel>/description}" placeholder="Description" rows="5" width="100%"/>
		</l:SimpleForm>
	</content>
	<buttons>
		<Button id="idCreateButton" text="{i18n>buttonCreate}" type="Emphasized" press=".onCreateButtonPress"/>
	</buttons>
</Dialog>