<Dialog
  title="{i18n>titleTicketCreation}"
  xmlns="sap.m"
  xmlns:l="sap.ui.layout.form" >
  <content>
    <l:SimpleForm  editable="true" layout="ResponsiveGridLayout" class="sapUiResponsiveMargin"  width="auto">
      <Label  text="{i18n>labelCategory}"/>
      <Input  value="{newTicket>Category}" placeholder="{i18n>labelCategory}"/>
      <Label  text="{i18n>labelLocation}"/>
      <Input  value="{newTicket>Location}" placeholder="{i18n>labelLocation}"/>
      <Label  text="{i18n>labelCostCenter}"/>
      <Input  value="{newTicket>CostCenter}" placeholder="{i18n>labelCostCenter}"/>
      <Label  text="{i18n>labelOrderNr}"/>
      <Input  value="{newTicket>OrderNumber}" placeholder="{i18n>labelOrderNr}"/>
      <Label text="{i18n>labelTitle}"/>
      <Input  value="{newTicket>Title}" placeholder="{i18n>labelTitle}"/>
      <TextArea 
          value="{newTicket>Description}" 
          placeholder="Description" 
          rows="5" 
          width="100%" />
    </l:SimpleForm>
  </content>

  <buttons>
    <Button  text="{i18n>buttonCreate}" type="Emphasized" press=".onCreateButtonPress"/>
  </buttons>
</Dialog>