<mvc:View  
	controllerName="ui5.ticketui.controller.TicketOverview" 
	xmlns="sap.m" 
	xmlns:tnt="sap.tnt" 
	xmlns:mvc="sap.ui.core.mvc">
	
	<Page id="ticketOverviewPage">
		<customHeader>
			<Toolbar>
				<Button icon="sap-icon://menu" press=".onToggleSideNav"/>
				<Title text="Tickets"/>
				<ToolbarSpacer/>
			</Toolbar>
		</customHeader>
		<content>
			<HBox fitContainer="true">
				<!-- MENU -->
				<tnt:SideNavigation id="sideNav" expanded="true" width="250px" itemSelect=".onNavSelect">
					<tnt:NavigationList id="navList">
						<tnt:NavigationListItem id="navDashboard" text="Dashboard" icon="sap-icon://home" select=".onNavSelect" key="dashboard"/>
						<tnt:NavigationListItem id="navTickets" text="Tickets" icon="sap-icon://document-text" select=".onNavSelect" key="tickets"/>
						<tnt:NavigationListItem id="navSettings" text="{i18n>settingsTitle}" icon="sap-icon://action-settings" select=".onNavSelect" key="settings"/>
            <tnt:NavigationListItem id="navLogout" text="{i18n>buttonLogout}" icon="sap-icon://log" select=".onNavSelect" key="logout"/>
					</tnt:NavigationList>
				</tnt:SideNavigation>
				<!-- CONTENT -->
				<VBox id="contentArea" class="sapUiSmallMargin">
					<Panel headerText="{i18n>titleTicketOverview}" class="sapUiResponsiveMargin" width="auto">
						<headerToolbar>
							<Toolbar>
								<Title text="{i18n>titleTicketOverview}"/>
								<ToolbarSpacer/>
								<Button text="{i18n>buttonNewTicket}" type="Emphasized" press=".onNewTicketButtonPress" icon="sap-icon://add"/>
							</Toolbar>
						</headerToolbar>
						<content>
							<SearchField width="100%" liveChange=".onSearchFieldsLiveChange"/>
							<Table items="{ticketsModel>/tickets}" mode="SingleSelectMaster" class="sapUiResponsiveMargin" width="auto" growing="false" growingScrollToLoad="true">
								<columns>
									<Column>
										<Text text="{i18n>columnNumber}"/>
									</Column>
									<Column>
										<Text text="{i18n>columnCategory}"/>
									</Column>
									<Column>
										<Text text="{i18n>columnLocation}"/>
									</Column>
									<Column>
										<Text text="{i18n>columnStatus}"/>
									</Column>
									<Column>
										<Text text="{i18n>columnPriority}"/>
									</Column>
									<Column>
										<Text text="{i18n>columnCreatedAt}"/>
									</Column>
									<Column>
										<Text text="{i18n>columnCreatedBy}"/>
									</Column>
									<Column>
										<Text text=""/>
									</Column>
								</columns>
								<items>
									<ColumnListItem type="Active">
										<cells>
											<Text text="{ticketsModel>id}"/>
											<Text text="{ticketsModel>category}"/>
											<Text text="{ticketsModel>location}"/>
											<Text text="{ticketsModel>status}"/>
											<Text text="{ticketsModel>priority}"/>
											<Text text="{path:'ticketsModel>createdAt', formatter:'.formatter.formatDate'}"/>
											<Text text="{ticketsModel>author}"/>
											<Button icon="sap-icon://sys-find" type="Emphasized" enabled="{= ${ticketsModel>status} !== 'Closed' }" press=".onViewDetailsButtonPress"/>
										</cells>
									</ColumnListItem>
								</items>
							</Table>
						</content>
					</Panel>
				</VBox>
			</HBox>
		</content>
	</Page>
</mvc:View>