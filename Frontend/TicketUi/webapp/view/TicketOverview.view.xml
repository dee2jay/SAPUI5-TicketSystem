<mvc:View  
	controllerName="ui5.ticketui.controller.TicketOverview" 
	xmlns="sap.m" 
	xmlns:tnt="sap.tnt" 
	xmlns:mvc="sap.ui.core.mvc">
	
	<Page id="idTicketOverviewPage">
		<customHeader>
			<Toolbar id="idToolbar">
				<Button id="idToggleSideNavButton" icon="sap-icon://menu" press=".onButtonToggleSideNavPress"/>
				<Title id="idTicketsTitle" text="Tickets"/>
				<ToolbarSpacer id="idCustsomHeaderToolbarSpacer"/>
			</Toolbar>
		</customHeader>
		<content>
			<HBox id="idHBox" fitContainer="true">
				<!-- MENU -->
				<tnt:SideNavigation id="idSideNavigation" expanded="true"  itemSelect=".onSideNavigationItemSelect">
					<tnt:NavigationList id="idNavigationList">						
						<tnt:NavigationListItem id="idTickets1NavigationListItem" text="Tickets" icon="sap-icon://document-text" select=".onTicketsNavigationListItemSelect" key="tickets"/>
						<tnt:NavigationListItem id="idSettings1NavigationListItem" text="{i18n>settingsTitle}" icon="sap-icon://action-settings" select=".onSettingsNavigationListItemSelect" key="settings"/>
						<tnt:NavigationListItem id="idLogoutNavigationListItem" text="{i18n>buttonLogout}" icon="sap-icon://log" select=".onLogoutNavigationListItemSelect" key="logout"/>
					</tnt:NavigationList>
				</tnt:SideNavigation>
				<!-- CONTENT -->
				<VBox id="idTicketOverviewContentVBox" class="sapUiSmallMargin">
					<Panel id="idTicketOverviewPanel" headerText="{i18n>titleTicketOverview}" class="sapUiResponsiveMargin" width="auto">
						<headerToolbar>
							<Toolbar id="idTicketOverviewToolbar">
								<Title id="idTicketsOverviewTitle" text="{i18n>titleTicketOverview}"/>
								<ToolbarSpacer id="idToolbarSpacer"/>
								<Button id="idNewTicketButton" text="{i18n>buttonNewTicket}" type="Emphasized" press=".onNewTicketButtonPress" icon="sap-icon://add"/>
							</Toolbar>
						</headerToolbar>
						<content>
							<SearchField id="idSearchField" width="100%" liveChange=".onSearchFieldsLiveChange"/>
							<Table id="idTicketsTable" items="{ticketsModel>/tickets}" mode="SingleSelectMaster" class="sapUiResponsiveMargin" width="auto" growing="false" growingScrollToLoad="true">
								<columns>
									<Column id="idNumberColumn">
										<Text id="idNumberText" text="{i18n>columnNumber}"/>
									</Column>
									<Column id="idCategoryColumn">
										<Text id="idCategoryText" text="{i18n>columnCategory}"/>
									</Column>
									<Column id="idLocationColumn">
										<Text id="idLocationText" text="{i18n>columnLocation}"/>
									</Column>
									<Column id="idStatusColumn">
										<Text id="idStatusText" text="{i18n>columnStatus}"/>
									</Column>
									<Column id="idPriorityColumn">
										<Text id="idPriorityText" text="{i18n>columnPriority}"/>
									</Column>
									<Column id="idCreatedAtColumn">
										<Text id="idCreatedAtText" text="{i18n>columnCreatedAt}"/>
									</Column>
									<Column id="idCreatedByColumn">
										<Text id="idCreatedByText" text="{i18n>columnCreatedBy}"/>
									</Column>
									<Column id="idAssignedUserColumn">
										<Text id="idCurrentOwnerText" text="{i18n>columnAssignedUser}"/>
									</Column>
									<Column id="idActionColumn">
										<Text id="idActionText" text=""/>
									</Column>
								</columns>
								<items>
									<ColumnListItem id="idColumnListItem" type="Active" detailPress=".onColumnListItemDetailPress">
										<cells>
											<Text id="idIdText" text="{ticketsModel>id}"/>
											<Text id="idCategory1Text" text="{ticketsModel>category}"/>
											<Text id="idLocation1Text" text="{ticketsModel>location}"/>
											<Text id="idStatus1Text" text="{ticketsModel>status}"/>
											<Text id="idPriority1Text" text="{ticketsModel>priority}"/>
											<Text id="idCreatedAt1Text" text="{parts:[{path: 'ticketsModel>createdAt'}], formatter: '.formatter.formatDateTimeWithTimezone'}"/>
											<Text id="idAuthorText" text="{ticketsModel>author}"/>
											<Text id="idAssignedToText" text="{ticketsModel>assignedTo}"/>
											<Button id="idDetailViewButton" icon="sap-icon://detail-view" type="Emphasized" enabled="{= ${ticketsModel>status} !== 'Closed' }" press=".onButtonViewDetailsPress"/>
										</cells>
									</ColumnListItem>
								</items>
							</Table>
						</content>
					</Panel>
				</VBox>
			</HBox>
		</content>
	</Page>
</mvc:View>