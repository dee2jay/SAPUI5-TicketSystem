<mvc:View 
          controllerName="ui5.ticketui.controller.TicketDetails"
          xmlns:mvc="sap.ui.core.mvc"
          xmlns="sap.m"
          xmlns:core="sap.ui.core"
          displayBlock="true">
	<Page id="idPage" title="{i18n>titleTicketDetails}"
	      showNavButton="true" 
	      navButtonPress=".onPageNavButtonPress">
		<Panel id="idPanel" headerText="{Ticket}">
			<HBox id="id2HBox" justifyContent="SpaceBetween"
			      alignItems="Center"
			      width="100%">
				<VBox id="id1VBox">
					<Text id="id1IdText" text="Ticket {ticketsModel>id}" class="boldText"/>
				</VBox>
				<HBox id="id3HBox">
					<Select id="idAssignedUserSelect" selectedKey="{ticketsModel>assignedTo}">
						<items>
						<core:Item id="idInselectAssigneeItem" key="" text="-- {i18n>selectAssignee} --" enabled="true"/>
						<core:Item id="idTicketAssignee0Item" key="Assignee0"
							           text="Ticket Assignee0"/>
							<core:Item id="idTicketAssignee1Item" key="Assignee1"
							           text="Ticket Assignee1"/>
							<core:Item id="idTicketAssignee2Item" key="Assignee2"
							           text="Ticket Assignee2"/>
							<core:Item id="idTicketAssignee3Item" key="Assignee3"
							           text="Ticket Assignee3"/>
						</items>
					</Select>
					<Select id="idStatusSelect" selectedKey="{ticketsModel>status}">
						<items>
						<core:Item id="idInselectStatusItem" key="" text="-- {i18n>selectStatus} --" enabled="true"/>
							<core:Item id="idOpenItem" key="Open"
							           text="Open"/>
							<core:Item id="idInProgressItem" key="InProgress"
							           text="In Progress"/>
							<core:Item id="idClosedItem" key="Closed"
							           text="Closed"/>
							<core:Item id="idWaitingItem" key="Waiting"
							           text="Waiting"/>
						</items>
					</Select>
					<Select id="idPrioritySelect" selectedKey="{ticketsModel>priority}">
						<items>
						<core:Item id="idInselectCategoryItem" key="" text="-- {i18n>selectCategory} --" enabled="true"/>
							<core:Item id="idLowItem" key="Low"
							           text="Low"/>
							<core:Item id="idMediumItem" key="Medium"
							           text="Medium"/>
							<core:Item id="idHighItem" key="High"
							           text="High"/>
							<core:Item id="idCriticalItem" key="Critical"
							           text="Critical"/>
						</items>
					</Select>
				</HBox>
			</HBox>
		</Panel>
		<Panel id="id2Panel" >
			<TextArea id="idDescription1TextArea" width="100%"
			          rows="4"
			          value="{ticketsModel>description}"
			          editable="false"/>
		</Panel>
		<Panel id="id4Panel" 
		       class="sapUiSmallMarginTop">
			<List id="idCommentsList" items="{ticketsModel>comments}" >
				<StandardListItem id="idStandardListItem" 
					title="{ticketsModel>author}"
					description="{ticketsModel>text}"
					icon="sap-icon://comment"
					info="{parts:[{path: 'ticketsModel>createdAt'}], formatter: '.formatter.formatDateTimeWithTimezone'}"/>
			</List>
			<VBox id="id3VBox">
				<TextArea id="idTextTextArea" placeholder="Kommentar hinzufügen..."
				          width="100%"
						  value="{commentViewModel>/text}"/>
				<Button id="idSendButton"  icon="sap-icon://paper-plane"
				        text="{i18n>buttonSend}" press="onSendButtonPress"/>
			</VBox>
		</Panel>
		<Toolbar id="idButtonToolbar">
			<Button id="idHistoryButton" text="{i18n>buttonHistory}"
			        icon="sap-icon://history"
			        type="Emphasized"
			        press=".onHistoryButtonPress"/>
			<Button id="idAttachmentsButton" text="{i18n>buttonAttachments}"
			        icon="sap-icon://attachment"
			        type="Emphasized"
			        press=".onAttachmentsButtonPress"/>
			<Button id="idPrintButton" text="{i18n>buttonPrint}"
			        icon="sap-icon://print"
			        type="Emphasized"
			        press=".onPrintButtonPress"/>
			<ToolbarSpacer  id="idButtonToolbarSpacer"/>
			<Button id="idSaveButton" text="{i18n>buttonSave}"
			        icon="sap-icon://save"
			        press=".onSaveButtonPress"
			        type="Emphasized"/>
			<Button id="idCancelButton" text="{i18n>buttonCancel}"
			        icon="sap-icon://cancel"
			        press=".onCancelButtonPress"
			        type="Emphasized"/>
		</Toolbar>
	</Page>
</mvc:View>