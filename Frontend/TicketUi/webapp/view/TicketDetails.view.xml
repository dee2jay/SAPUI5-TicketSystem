<mvc:View 
          controllerName="ui5.ticketui.controller.TicketDetails"
          xmlns:mvc="sap.ui.core.mvc"
          xmlns="sap.m"
          xmlns:core="sap.ui.core"
          displayBlock="true">
	<Page title="{i18n>titleTicketDetails}"
	      showNavButton="true"
	      navButtonPress=".onNavBack">
		<Panel headerText="{Ticket}">
			<HBox justifyContent="SpaceBetween"
			      alignItems="Center"
			      width="100%">
				<VBox>
					<Text text="Ticket {ticketsModel>id}"/>
				</VBox>
				<HBox gap="10px">
					<Select selectedKey="{ticketsModel>status}">
						<items>
							<core:Item key="Open"
							           text="Open"/>
							<core:Item key="InProgress"
							           text="In Progress"/>
							<core:Item key="Closed"
							           text="Closed"/>
							<core:Item key="Waiting"
							           text="Waiting"/>
						</items>
					</Select>
					<Select selectedKey="{ticketsModel>priority}">
						<items>
							<core:Item key="Low"
							           text="Low"/>
							<core:Item key="Medium"
							           text="Medium"/>
							<core:Item key="High"
							           text="High"/>
							<core:Item key="Critical"
							           text="Critical"/>
						</items>
					</Select>
				</HBox>
			</HBox>
		</Panel>
		<Panel headerText="{i18n>descriptionTitle}">
			<TextArea width="100%"
			          rows="4"
			          value="{ticketsModel>description}"
			          editable="false"/>
		</Panel>
		<Panel headerText="{i18n>commentsTitle}"
		       class="sapUiSmallMarginTop">
			<List items="{ticketsModel>comments}" >
				<StandardListItem 
					title="{ticketsModel>author}"
					description="{ticketsModel>text}"
					icon="sap-icon://comment"
					info="{path: 'ticketsModel>createdAt', formatter: '.formatter.formatDateTime'}"/>
			</List>
			<VBox>
				<TextArea placeholder="Kommentar hinzufügen..."
				          width="100%"
				          rows="2"
						  value="{commentViewModel>/text}"/>
				<Button icon="sap-icon://paper-plane"
				        text="Senden" press="onSendenButtonPress"/>
			</VBox>
		</Panel>
		<Toolbar>
			<Button text="{i18n>buttonHistory}"
			        icon="sap-icon://history"
			        type="Emphasized"
			        press=".onHistoryButtonPress"/>
			<Button text="{i18n>buttonAttachments}"
			        icon="sap-icon://attachment"
			        type="Emphasized"
			        press=".onAttachmentsButtonPress"/>
			<Button text="{i18n>buttonPrint}"
			        icon="sap-icon://print"
			        type="Emphasized"
			        press=".onPrintButtonPress"/>
			<ToolbarSpacer/>
			<Button text="{i18n>buttonSave}"
			        icon="sap-icon://save"
			        press=".onSaveButtonPress"
			        type="Emphasized"/>
			<Button text="{i18n>buttonCancel}"
			        icon="sap-icon://cancel"
			        press=".onCancelButtonPress"
			        type="Emphasized"/>
		</Toolbar>
	</Page>
</mvc:View>