<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:unified="sap.ui.unified">
    <Dialog
        id="idAttachmentDialog"
        title="{i18n>titleTicketAttachments}"        
        afterClose=".onDialogAfterClose">
        <VBox id="IdVBox" class="sapUiSmallMargin">
            <unified:FileUploader
                id="idFileUploader"
                name="file"
                sendXHR="true"
                uploadComplete=".onFileUploaderUploadComplete"
                change=".onFileUploaderChange"
                width="100%"/>
            <Button id="idUploadButton"
                text="{i18n>buttonUpload}"
                type="Emphasized"
                press=".onUploadButtonPress"/>

            <List id="idAttachmentsList"
                headerText="{i18n>titleTicketAttachmentList}"
                items="{ticketsModel>attachments}">
                <CustomListItem id="idCustomListItem" type="Active">
                    <HBox id="id1HBox" justifyContent="SpaceBetween" alignItems="Center">                
                    
                    <core:Icon id="idIcon" src= "sap-icon://document" />
                    <Text id="idFileNameText" text="{ticketsModel>fileName}" />

                    <Button id="idDeleteButton" icon="sap-icon://delete" press=".onDeleteButtonPress"/>
                    <!-- <Button id="idPreviewButton" icon="sap-icon://image-viewer" press=".onPreviewButtonPress"/> -->
                    </HBox>
                </CustomListItem>                
            </List>
        </VBox>

        <VBox id="idViewerBox" visible="false" class="sapSmallMarginTop">
            <Title id="idFilePreviewTitle" text="{i18n>filePreview}"/>
            <!-- PDF -->
            <PDFViewer
                id="idPDFViewer"
                visible="false"
                width="100%"
                height="600px"/>

            <!-- Image -->
            <Image
                id="idViewerImage"
                visible="false"
                width="100%"
                densityAware="false"/>
        </VBox>
        <endButton>
            <Button id="idCloseButton" text="{i18n>buttonClose}" press=".onCloseButtonPress"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>