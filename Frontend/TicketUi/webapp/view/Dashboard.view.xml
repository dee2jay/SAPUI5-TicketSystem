<mvc:View  xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:tnt="sap.tnt" displayBlock="true" controllerName="ui5.ticketui.controller.Dashboard">
	<Page id="id2Page">
		<customHeader>
			<Toolbar id="id1Toolbar">
				<Button id="idToggleSideNav1Button" icon="sap-icon://menu" press=".onButtonToggleSideNavPress"/>
				<Title id="idDashboardTitle" text="Dashboard"/>
				<ToolbarSpacer id="id1ToolbarSpacer"/>
			</Toolbar>
		</customHeader>
		<content>
			<HBox id="id5HBox" fitContainer="true">
				<tnt:SideNavigation id="id1SideNavigation"  itemSelect=".onSideNavigationItemSelect">
					<tnt:NavigationList id="id2NavigationList">
						<tnt:NavigationListItem id="idDashboardNavigationListItem" text="Dashboard" icon="sap-icon://home" select=".onDashboardNavigationListItemSelect" key="dashboard"/>
						<tnt:NavigationListItem id="idTicketsNavigationListItem" text="Tickets" icon="sap-icon://document-text" select=".onTicketsNavigationListItemSelect" key="tickets"/>
						<tnt:NavigationListItem id="idSettingsNavigationListItem" text="{i18n>settingsTitle}" icon="sap-icon://action-settings" select=".onSettingsNavigationListItemSelect" key="settings"/>
                        <tnt:NavigationListItem id="idLogout1NavigationListItem" text="{i18n>buttonLogout}" icon="sap-icon://log" select=".onLogoutNavigationListItemSelect" key="logout"/>
					</tnt:NavigationList>
				</tnt:SideNavigation>
				<VBox id="id5VBox" class="sapUiSmallMargin">
					<HBox id="id6HBox" justifyContent="SpaceAround">
						<ObjectStatus id="idTicketCreatesObjectStatus" title="{i18n>dashboardTicketsCreated}" text="12" state="Warning"/>
						<ObjectStatus id="idTicketClosedObjectStatus" title="{i18n>dashboardTicketsClosed}" text="34" state="Success"/>
						<ObjectStatus id="idTicketInProgressObjectStatus" title="{i18n>dashboardTicketsInProgress}" text="5" state="Information"/>
					</HBox>
					<Panel id="id5Panel" headerText="{i18n>dashboardRecentTickets}" class="sapUiSmallMarginTop">
                    
                </Panel>
					<Panel id="id6Panel" headerText="{i18n>dashboardTicketsInProgress}" class="sapUiSmallMarginTop">
						<Table id="id1Table">
							<columns>
								<Column id="idNumber1Column">
									<Text id="idNumber1Text" text="{i18n>columnNumber}"/>
								</Column>
								<Column id="idTitle1Column" >
									<Text id="idTitle1Text" text="{i18n>columnTitle}"/>
								</Column>
								<Column id="idStatus1Column" >
									<Text id="idStatus2Text"  text="{i18n>columnStatus}"/>
								</Column>
							</columns>
							<items>
								<ColumnListItem id="id1ColumnListItem">
									<cells>										
									</cells>
								</ColumnListItem>
								<ColumnListItem id="id2ColumnListItem">
									<cells>										
									</cells>
								</ColumnListItem>
							</items>
						</Table>
					</Panel>
				</VBox>
			</HBox>
		</content>
	</Page>
</mvc:View>