<mvc:View controllerName="ui5.ticketui.controller.AppSetting" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:tnt="sap.tnt" xmlns:core="sap.ui.core">
	<Page id="idSettingsTitlePage" title="{i18n>settingsTitle}">
		<content>
			<HBox id="idSettingsHBox" fitContainer="true">
				<tnt:SideNavigation id="sideNav" expanded="true" itemSelect=".onNavSelect">
					<tnt:NavigationList id="navList">
						<tnt:NavigationListItem id="navDashboard" text="Dashboard" icon="sap-icon://home"  key="dashboard"/>
						<tnt:NavigationListItem id="navTickets" text="Tickets" icon="sap-icon://document-text" key="tickets"/>
						<tnt:NavigationListItem id="navSettings" text="{i18n>settingsTitle}" icon="sap-icon://action-settings" key="settings"/>
            			<tnt:NavigationListItem id="navLogout" text="{i18n>buttonLogout}" icon="sap-icon://log" key="logout"/>
					</tnt:NavigationList>
				</tnt:SideNavigation>
				<VBox class="sapUiSmallMargin">					
					<Label text="{i18n>labelTheme}"/>
					<Select>
						<items>
							<core:Item key="{i18n>appConfigKeyLight}" text="{i18n>appConfigOptionLight}"/>
							<core:Item key="{i18n>appConfigKeyDark}" text="{i18n>appConfigOptionDark}"/>
						</items>
					</Select>
					<Label text="{i18n>labelLang}"/>
					<Select>
						<items>
							<core:Item key="{i18n>appConfigKeyEnglish}" text="{i18n>appConfigOptionEnglish}"/>
							<core:Item key="{i18n>appConfigKeyGerman}" text="{i18n>appConfigOptionGerman}"/>
						</items>
					</Select>
					<HBox class="sapUiSmallMarginTop">
						<Button text="{i18n>buttonSave}" type="Emphasized" press=".onSaveSettingsPress"/>
						<Button text="{i18n>buttonCancel}" press=".onCancelSettingsPress" class="sapUiSmallMarginBegin"/>
					</HBox>
				</VBox>
			</HBox>
		</content>
	</Page>
</mvc:View>