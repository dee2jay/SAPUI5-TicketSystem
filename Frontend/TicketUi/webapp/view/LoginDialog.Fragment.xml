<core:FragmentDefinition 
    xmlns="sap.m" 
    xmlns:core="sap.ui.core" 
    xmlns:mvc="sap.ui.core.mvc">
    <Dialog    
        xmlns="sap.m"
        xmlns:mvc="sap.ui.core.mvc" 
        title="{i18n>loginTitle}"
        id="loginDialog">

        <content>
            <VBox class="sapUiSmallMargin">
                <Label text="{i18n>labelUsername}" labelFor="usernameInput"/>
                <Input id="usernameInput" placeholder="{i18n>textUsername}" value="{/username}"/>

                <Label text="{i18n>labelPassword}" labelFor="passwordInput" class="sapUiSmallMarginTop"/>
                <Input id="passwordInput" type="Password" placeholder="{i18n>textPassword}" value="{/password}"/>
                
                <Toolbar>
                    <ToolbarSpacer/>
                    <Button text="{i18n>buttonSubmit}" type="Emphasized" press=".onButtonSubmitPress"/>
                    <Button text="{i18n>buttonCancel}" press=".onButtonCancelPress"/>                    
                </Toolbar>
                
            </VBox>
        </content>    

   </Dialog>
    
</core:FragmentDefinition>
