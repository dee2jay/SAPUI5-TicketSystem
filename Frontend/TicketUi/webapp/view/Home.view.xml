<mvc:View controllerName="ui5.ticketui.controller.Home" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:tnt="sap.tnt" xmlns:core="sap.ui.core">
	<Page>
		<customHeader>
			<Toolbar>				
				<Title text="{i18n>appTitle}"/>
				<ToolbarSpacer/>
			</Toolbar>
		</customHeader>
		<content>
			<HBox fitContainer="true">
				<VBox id="contentArea" class="sapUiSmallMargin" width="100%">
					<Panel headerText="Welcome" class="sapUiResponsiveMargin" width="auto">
						<headerToolbar>
							<Toolbar>
								<Title text="{i18n>appWelcomeMessage}"/>
								<ToolbarSpacer/>
							</Toolbar>
						</headerToolbar>
					</Panel>
					<Panel class="sapUiResponsiveMargin" width="auto">
						<VBox class="sapUiSmallMargin">
							<Label text="{i18n>labelUsername}" labelFor="usernameInput"/>
							<Input  placeholder="{i18n>textUsername}" value="{loginUserViewModel>/email}"/>
							<Label text="{i18n>labelPassword}" labelFor="passwordInput" class="sapUiSmallMarginTop"/>
							<Input  type="Password" placeholder="{i18n>textPassword}" value="{loginUserViewModel>/password}"/>
							<HBox class="sapUiSmallMarginTop" justifyContent="End">
								<ToolbarSpacer/>
								<Button class="sapUiSmallMarginEnd" text="{i18n>buttonSubmit}" type="Emphasized" press=".onButtonSubmitPress"/>								
							</HBox>							
						</VBox>
					</Panel>
					<Panel headerText="Login with SSO" class="sapUiResponsiveMargin" width="auto">
						<VBox class="sapUiSmallMargin">							
							<HBox class="sapUiSmallMarginTop" justifyContent="End">
								
								<Button class="sapUiSmallMarginEnd" text="{i18n>buttonSsoSubmit}" type="Emphasized" width="100%" press=".onButtonSubmitSsoPress"/>								
							</HBox>							
						</VBox>
					</Panel>
				</VBox>
			</HBox>
		</content>
	</Page>
</mvc:View>