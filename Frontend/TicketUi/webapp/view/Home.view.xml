<mvc:View controllerName="ui5.ticketui.controller.Home" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m">
	<Page id="id4Page">
		<customHeader>
			<Toolbar id="id4Toolbar"> 				
				<Title id="idTicketManagementSystemTitle" text="{i18n>appTitle}"/>
				<ToolbarSpacer id="id4ToolbarSpacer"/>
			</Toolbar>
		</customHeader>
		<content>
			<HBox id="id9HBox" fitContainer="true">
				<VBox id="idVBox" class="sapUiSmallMargin" width="100%">
					<Panel id="idWelcomePanel" headerText="Welcome" class="sapUiResponsiveMargin" width="auto">
						<headerToolbar>
							<Toolbar id="id5Toolbar">
								<Title id="idWelcomeTitle" text="{i18n>appWelcomeMessage}"/>
								<ToolbarSpacer id="id7ToolbarSpacer"/>
							</Toolbar>
						</headerToolbar>
					</Panel>
					<Panel id="idLoginPanel" class="sapUiResponsiveMargin" width="auto">
						<VBox id="id6VBox" class="sapUiSmallMargin">
							<Label  id="idUsernameLabel" text="{i18n>labelUsername}" labelFor="usernameInput"/>
							<Input id="idEmailInput"  placeholder="{i18n>textUsername}" value="{loginUserViewModel>/email}"/>
							<Label id="idPasswordLabel" text="{i18n>labelPassword}" labelFor="passwordInput" class="sapUiSmallMarginTop"/>
							<Input id="idPasswordInput" type="Password" placeholder="{i18n>textPassword}" value="{loginUserViewModel>/password}"/>
							<HBox id="id7HBox" class="sapUiSmallMarginTop" justifyContent="End">
								<ToolbarSpacer id="id3ToolbarSpacer" />
								<Button id="idLoginButton" class="sapUiSmallMarginEnd" text="{i18n>buttonSubmit}" type="Emphasized" press=".onLoginButtonPress"/>								
							</HBox>							
						</VBox>
					</Panel>
					<Panel id="id7Panel" headerText="Login with SSO" class="sapUiResponsiveMargin" width="auto">
						<VBox id="id7VBox" class="sapUiSmallMargin">							
							<HBox id="id8HBox" class="sapUiSmallMarginTop" justifyContent="End">
								
								<Button id="idLoginWithEntraIDButton" class="sapUiSmallMarginEnd" text="{i18n>buttonSsoSubmit}" type="Emphasized" width="100%" press=".onLoginWithEntraIDButtonPress"/>								
							</HBox>							
						</VBox>
					</Panel>
				</VBox>
			</HBox>
		</content>
	</Page>
</mvc:View>