<mvc:View 
    controllerName="ui5.ticketui.controller.TicketHistory"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"    
    displayBlock="true"
    height="100%"
    busyIndicatorDelay="0">

    <Page id="idHistoryPage"
          title="{i18n>titleTicketHistory}"
          showNavButton="true"
          navButtonPress=".onPageTicketHistoryNavButtonPress">

        <content>
            <List id="idHistoriesList"                       
                items="{
                    path: 'ticketsModel>histories'
                }"
                width="100%">

                <CustomListItem id="id2CustomListItem">
                    <VBox id="idCustomListItemVBox">      
                    <Text id="idAction1Text" text="{ticketsModel>action}"/>                                        
                    </VBox>
                </CustomListItem>
                    
                    
            </List>

        </content>       

    </Page>
</mvc:View>