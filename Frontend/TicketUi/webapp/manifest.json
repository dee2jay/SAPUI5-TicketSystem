{
  "_version": "1.65.0",
  "sap.app": {
    "id": "ui5.ticketui",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}"
  },
    "sap.ui": {
        "technology": "UI5",
        "supportedThemes": [
        "sap_fiori_3",
        "sap_belize",
        "sap_belize_plus",
        "sap_fiori_3_dark",
        "sap_fiori_3_hcb",
        "sap_fiori_3_hcw"
        ],
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },
    "sap.ui5": {
        "flexEnabled": true,
        "contentDensities": {
            "compact": true,
            "cozy": true
        },
        "rootView": {
            "viewName": "ui5.ticketui.view.App",
            "type": "XML",
            "id": "app"
        },
        "dependencies": {
            "minUI5Version": "1.65.0",
            "libs": {
                "sap.m": {},
                "sap.ui.core": {},
                "sap.tnt": {}
            }
        },
        "models": {
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                    "bundleName": "ui5.ticketui.i18n.i18n",
                    "supportedLocales": ["","en_US", "de_DE"],
                    "fallbackLocale": "en_US"
                }
            }
        },
        "routing": {
            "config":{
                "routerClass": "sap.m.routing.Router",
                "type": "View",
                "viewType": "XML",
                "path": "ui5.ticketui.view", 
                "controlId": "app",               
                "controlAggregation": "pages"
            },
            "routes": [
                {
                    "pattern": "",
                    "name": "home",
                    "target": "home"
                },
                {
                    "pattern": "dashboard",
                    "name": "dashboard",
                    "target": "dashboard"
                },
                {
                    "pattern": "settings",
                    "name": "settings",
                    "target": "settings"
                },
                {
                    "pattern": "tickets",
                    "name": "tickets",
                    "target": "tickets"
                },
                {
                    "pattern": "ticketDetails/{ticketId}",
                    "name": "ticketDetails",
                    "target": "ticketDetails"
                }
            ],
            "targets": {
                    "home": {
                        "viewName": "Home",
                        "viewId": "homeView",
                        "controlId": "app",
                        "clearControlAggregation": true,
                        "transition": "slide",
                        "transitionParameters": {
                            "direction": "right"
                        }, 
                        "controlAggregation": "pages"
                    },
                    "dashboard": {
                        "viewName": "Dashboard",
                        "viewId": "dashboardView",
                        "controlId": "app",
                        "clearControlAggregation": true,
                        "transition": "slide",
                        "transitionParameters": {
                            "direction": "left"
                        },
                        "controlAggregation": "pages"                    
                    },
                    "tickets": {
                        "viewName": "TicketOverview",
                        "viewId": "ticketOverviewView",
                        "controlId": "app",
                        "clearControlAggregation": true,
                        "transition": "slide",
                        "transitionParameters": {
                            "direction": "left"
                        },
                        "controlAggregation": "pages"                    
                    },
                    "ticketDetails": {
                        "viewName": "TicketDetails",
                        "viewId": "ticketDetailsView",
                        "controlId": "app",
                        "clearControlAggregation": true,
                        "transition": "slide",
                        "transitionParameters": {
                            "direction": "left"
                        },
                        "controlAggregation": "pages"                    
                    },
                    "settings": {
                        "viewName": "AppSetting",
                        "viewId": "settings",
                        "controlId": "app",
                        "clearControlAggregation": true,
                        "transition": "slide",
                        "transitionParameters": {
                            "direction": "left"
                        },
                        "controlAggregation": "pages"
                    }
                }
        }
    }
}