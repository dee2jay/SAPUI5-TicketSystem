<Dialog
  id="createTicketDialog"
  title="Neues Ticket erstellen"
  xmlns="sap.m"
  xmlns:l="sap.ui.layout">
  <content>
    <l:SimpleForm editable="true" layout="ResponsiveGridLayout">
      <Label text="Titel"/>
      <Input value="{newTicket>Title}" placeholder="Ticket Titel"/>
      <Label text="Beschreibung"/>
      <TextArea value="{newTicket>Description}" rows="4"/>
      <Label text="Priorität"/>
      <Select selectedKey="{newTicket>Priority}">
        <items>
          <core:Item key="1" text="Low"/>
          <core:Item key="2" text="Normal"/>
          <core:Item key="3" text="High"/>
        </items>
      </Select>
    </l:SimpleForm>
  </content>
  <buttons>
    <Button text="Cancel" press=".onCancelCreate"/>
    <Button text="Create" type="Emphasized" press=".onConfirmCreate"/>
  </buttons>
</Dialog>