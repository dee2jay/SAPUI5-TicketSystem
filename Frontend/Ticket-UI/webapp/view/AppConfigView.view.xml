<mvc:View
  controllerName="ticket-ui.controller.AppConfig"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m">
  <Page id="_IDGenPage1" title="{I18n>titleAppConfig}">
    <content>      
      <Label id="labelTheme">Language</Label>
      <Select id="_IDGenSelect">
        <items>
          <core:Item id="_IDGenItem" key="light" text="Light"/>
          <core:Item id="_IDGenItem1" key="dark" text="Dark"/>
        </items>
      </Select>
      <Label id="labelLang">Language</Label>
      <Select id="_IDGenSelect_1">
        <items>
          <core:Item id="_IDGenItem2" key="english" text="English"/>
          <core:Item id="_IDGenItem3" key="german" text="German"/>
        </items>
      </Select>
    </content>
  </Page>
</mvc:View>