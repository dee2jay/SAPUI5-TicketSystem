<mvc:View 
    controllerName="ticket-ui.controller.App"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true">
    <Shell id="_IDGenShell" >
    <App id="_IDGenApp1" class="lenzing">
        <pages>
            <Page id="_IDGenPage" title="{i18n>appTitle}">
            <content>
               <Panel id="_IDGenPanel2"
                  headerText="{i18n>titleTicketOverview}" class="sapUiResponsiveMargin" width="auto">
                  <content>
                     <mvc:XMLView id="_IDGenXMLView" viewName="ticket-ui.view.TicketOverview"></mvc:XMLView>
                  </content>
               </Panel>
            </content>
            </Page>
        </pages>
    </App>
    </Shell>  
</mvc:View>