<mvc:View 
    controllerName="ui5.walkthrough.controller.App"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true">
    <Shell >
    <App class="myAppDemoWT">
        <pages>
            <Page title="{i18n>homePageTitle}">
            <content>
               <Panel
                  headerText="{i18n>helloPanelTitle}" class="sapUiResponsiveMargin" width="auto">
                  <content>
                     <mvc:XMLView viewName="ui5.walkthrough.view.HelloPanel"></mvc:XMLView>
                  </content>
               </Panel>
            </content>
            </Page>
        </pages>
    </App>
    </Shell>
    
    <Button 
    text="{i18n>showHelloButtonText}"
    press=".onShowHello" />
    <Input 
        value="{/recipient/name}"
        description="Hello {/recipient/name}"
        valueLiveUpdate="true" 
        width="60%"/>
</mvc:View>