<mvc:View
  controllerName="ticket-ui.controller.TicketDetails"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.f">
  <Page id="pageTicketDetails" title="{I18n>titleTicketDetails}">
    <content>
      <ObjectHeader id="_IDGenObjectHeader"
        title="{Tickets>Title}"
        number="{Tickets>ID}"
        numberUnit="Ticket-ID"
        intro="{Tickets>Status}" />

      <Panel id="_IDGenPanel" headerText="Beschreibung">
        <Text id="_IDGenText1" text="{Tickets>Description}" wrapping="true"/>
      </Panel>

      <Panel id="_IDGenPanel1" headerText="Kommentare">
        <List id="chatList" items="{Comments>/}">
          <StandardListItem id="_IDGenStandardListItem" title="{Comments>User}" description="{Comments>Text}" info="{Comments>Date}"/>
        </List>
        <HBox id="_IDGenHBox">
          <Input id="chatInput" placeholder="Kommentar hinzufügen..." width="80%"/>
          <Button id="_IDGenButton" icon="sap-icon://send" press=".onSendMessage"/>
        </HBox>
      </Panel>
    </content>
  </Page>
</mvc:View>